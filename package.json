{
  "name": "oasis-bi-pro-cloudflare",
  "type": "module",
  "version": "3.0.0",
  "description": "OASIS BI Pro — Sovereign BI SaaS on Cloudflare full-stack ecosystem (Pages + Workers + D1 + KV) with Duitku payment gateway integration",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=oasis-bi-pro-production --kv=OASIS_KV --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name oasis-bi-pro",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "db:migrate:local": "wrangler d1 migrations apply oasis-bi-pro-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply oasis-bi-pro-production",
    "db:seed:local": "wrangler d1 execute oasis-bi-pro-production --local --file=./seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "db:console:local": "wrangler d1 execute oasis-bi-pro-production --local"
  },
  "dependencies": {
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@cloudflare/workers-types": "^4.20250705.0",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0",
    "typescript": "^5.6.0"
  }
}
